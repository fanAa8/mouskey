{
  "name": "keyforge-native-settings",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "test": "for %f in (scripts\\test-*.cjs) do @node %f || exit /b 1",
    "sync-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-release.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "koffi": "^3.2.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "express": "^5.2.1",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "build": {
    "appId": "com.mouskey.app",
    "productName": "MousKey",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "vite.config.ts",
      "tsconfig.json",
      "package.json",
      "node_modules/**/*",
      "tools/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
